{
  "buildCommand": "node build-env.js",
  "outputDirectory": ".",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/env.js",
      "headers": {
        "Cache-Control": "public, max-age=300"
      }
    }
  ]
}